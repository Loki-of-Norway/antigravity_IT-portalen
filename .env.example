# Kopier denne filen til .env og fyll inn egne verdier. .env skal aldri committes.

# Database (lokal MySQL eller Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=IT-portalen

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=bytt-til-en-lang-tilfeldig-streng

# Google Gemini (chatbot og Loki-tutor)
GEMINI_API_KEY=

# Brukes av seed_admin.js for å opprette admin-brukeren
ADMIN_USERNAME=LokiAdmin
ADMIN_EMAIL=
ADMIN_PASSWORD=
